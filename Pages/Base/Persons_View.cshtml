@model Sarmad.Pages.Base.PersonsModel
@using System.Data;
@using Sarmad.Services;
@{
    var ZF = ""; var RJ = 0;
}
@switch (@ViewData["Switch"])
{
    case "ListPerson":

        <div class="d-flex flex-wrap justify-content-between border-top border-secondary">
            <div class="Area_Count w-fix-200">
                <span>تعداد : </span><span>@Model.ListPersons.Rows.Count </span>
            </div>
        </div>


        <div class="header_Table">
            <button type="button" class="btn_Icon footer_Right Icon_Red icofont-00x icofont-curved-double-right" title="اسکرول به راست" onclick="ScrollRight('@ViewData["Switch"]_FT');"></button>
            <button type="button" class="btn_Icon footer_Left Icon_Red icofont-00x icofont-curved-double-left" title="اسکرول به چپ" onclick="ScrollLeft('@ViewData["Switch"]_FT');"></button>
            <div id="@ViewData["Switch"]_FT" class="overflow-hidden" onscroll="ScrollSlave(this, '@ViewData["Switch"]_MS');">
                <table class="table grid-table">
                    <thead>
                        <tr>
                            <th><span>#</span></th>
                            <th><span class="w-fix-50">کد</span></th>
                            <th><span class="w-fix-200"> نام مشتری</span></th>
                            <th><span class="w-fix-150">همراه</span></th>
                            <th><span class="w-fix-150">تلفن</span></th>
                            <th><span class="w-fix-150">کد ملی</span></th>
                            <th><span class="w-fix-300"><span>آدرس</span> / <span>توضیح</span></span></th>
                            <th><span class="w-fix-100">وضعیت</span></th>
                            <th><span class="w-fix-100">ماهیت</span></th>
                            <th><span class="w-fix-200">گروه ها</span></th>
                            <th><span class="w-fix-50">ویرایش</span></th>
                            <th><span class="w-fix-50">حذف</span></th>
                            <th><span class="w-fix-180"><span>ویرایشگر</span> / <span>زمان</span></span></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
        <div class="overflow-auto" id="@ViewData["Switch"]_MS" onscroll="ScrollSlave(this, '@ViewData["Switch"]_FT');">
            <table class="table grid-table">
                <thead class="header_Tablehiden">
                    <tr>
                        <th><span>#</span></th>
                        <th><span class="w-fix-50">کد</span></th>
                        <th><span class="w-fix-200"> نام مشتری</span></th>
                        <th><span class="w-fix-150">همراه</span></th>
                        <th><span class="w-fix-150">تلفن</span></th>
                        <th><span class="w-fix-150">کد ملی</span></th>
                        <th><span class="w-fix-300"><span>آدرس</span> / <span>توضیح</span></span></th>
                        <th><span class="w-fix-100">وضعیت</span></th>
                        <th><span class="w-fix-100">ماهیت</span></th>
                        <th><span class="w-fix-200">گروه ها</span></th>
                        <th><span class="w-fix-50">ویرایش</span></th>
                        <th><span class="w-fix-50">حذف</span></th>
                        <th><span class="w-fix-180"><span>ویرایشگر</span> / <span>زمان</span></span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DataRow item in Model.ListPersons.Rows)
                    {
                        { RJ++; }
                        <tr onclick="RowSelect(this);" id="Per_@item["Si"]">
                            <td class="text-danger">@RJ</td>
                            <td>@item["Cu_Person"]</td>
                            <td><span class="w-fixC-200">@item["FirstName"] @item["LastName"]</span></td>
                            <td><span class="w-fixC-150">@item["MobileNo"]</span></td>
                            <td><span class="w-fixC-150">@item["PhoneNo"]</span></td>
                            <td><span class="w-fixC-150">@item["NationalCode"]</span></td>
                            <td><span class="w-fixC-300"><span>@item["Adres"]</span><span class="text_line22">@item["Sharh"]</span></span></td>
                            <td><span class="w-fixC-100">@item["ActiveTp"]</span></td>
                            <td><span class="w-fixC-100">@item["Mahiyat"]</span></td>
                            <td><span class="w-fixC-200">@item["Groups"]</span></td>
                            <td>
                                <button type="button" class="btn_Icon Icon_Mor icofont-00x icofont-edit" title="ویرایش" onclick="ClickBtnSimpl('FormSabtPersonBtn', '@item["Si"]');"></button>
                            </td>
                            <td>
                                <button type="button" class="btn_Icon Icon_Red icofont-00x icofont-bin" title="حذف" onclick="ClickBtnSimpl('DeletePersonBtn', '@item["Si"]');"></button>
                            </td>
                            <td><span class="w-fixC-180 text-start"><span>@item["EditorName"]</span><span class="text_line23 ltr">@item["TimeEdit"]</span></span></td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>

        <div hidden>
            <form method="post" data-ajax="true" data-ajax-method="post"
                  data-ajax-confirm="آیا این شخص حذف گردد؟"
                  data-ajax-Btn="DeletePersonBtn"
                  data-ajax-begin="SpinnerShowForm('چند لحظه صبر کنید');"
                  data-ajax-url="?handler=DeletePerson"
                  data-ajax-complete="CompleteResult"
                  data-ajax-success="AreaHide('Per_'+EleValue('DeletePersonBtn'))">
                <input type="submit" hidden id="DeletePersonBtn" name="ID" />
            </form>

        </div>
        break;


    case "ListKarbaran":
        <div class="d-flex flex-wrap justify-content-between border-top border-secondary">
            <div class="Area_Count w-fix-200">
                <span>تعداد : </span><span>@Model.ListPersons.Rows.Count </span>
            </div>
        </div>

        <div class="header_Table">
            <button type="button" class="btn_Icon footer_Right Icon_Red icofont-00x icofont-curved-double-right" title="اسکرول به راست" onclick="ScrollRight('@ViewData["Switch"]_FT');"></button>
            <button type="button" class="btn_Icon footer_Left Icon_Red icofont-00x icofont-curved-double-left" title="اسکرول به چپ" onclick="ScrollLeft('@ViewData["Switch"]_FT');"></button>
            <div id="@ViewData["Switch"]_FT" class="overflow-hidden" onscroll="ScrollSlave(this, '@ViewData["Switch"]_MS');">
                <table class="table grid-table">
                    <thead>
                        <tr>
                            <th><span>#</span></th>
                            <th><span class="w-fix-50"><span class="icofont icofont-2x icofont-waiter-alt"></span></span></th>
                            <th><span class="w-fix-50">کد</span></th>
                            <th><span class="w-fix-200">نام کاربر</span></th>
                            <th><span class="w-fix-125">عنوان کاربری</span></th>
                            <th><span class="w-fix-50">ویرایش</span></th>
                            <th><span class="w-fix-50">تخصیصها</span></th>
                            <th><span class="w-fix-50">حذف</span></th>
                            <th><span class="w-fix-50">ورود</span></th>
                            <th><span class="w-fix-200">آخرین ورود</span></th>
                            <th><span class="w-fix-50">فعال</span></th>
                            <th><span class="w-fix-300">توضیح</span></th>
                            <th><span class="w-fix-140">آی پی</span></th>
                            <th><span class="w-fix-100">تاریخ شروع</span></th>
                            <th><span class="w-fix-180"><span>ویرایشگر</span> / <span>زمان</span></span></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
        <div class="overflow-auto" id="@ViewData["Switch"]_MS" onscroll="ScrollSlave(this, '@ViewData["Switch"]_FT');">
            <table class="table grid-table">
                <thead class="header_Tablehiden">
                    <tr>
                        <th><span>#</span></th>
                        <th><span class="w-fix-50"><span class="icofont icofont-2x icofont-waiter-alt"></span></span></th>
                        <th><span class="w-fix-50">کد</span></th>
                        <th><span class="w-fix-200">نام کاربر</span></th>
                        <th><span class="w-fix-125">عنوان کاربری</span></th>
                        <th><span class="w-fix-50">ویرایش</span></th>
                        <th><span class="w-fix-50">تخصیصها</span></th>
                        <th><span class="w-fix-50">حذف</span></th>
                        <th><span class="w-fix-50">ورود</span></th>
                        <th><span class="w-fix-200">آخرین ورود</span></th>
                        <th><span class="w-fix-50">فعال</span></th>
                        <th><span class="w-fix-300">توضیح</span></th>
                        <th><span class="w-fix-140">آی پی</span></th>
                        <th><span class="w-fix-100">تاریخ شروع</span></th>
                        <th><span class="w-fix-180"><span>ویرایشگر</span> / <span>زمان</span></span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DataRow item in Model.ListPersons.Rows)
                    {
                        { RJ++; }
                        <tr onclick="RowSelect(this);" id="User_@item["Si"]">
                            <td class="text-danger">@RJ</td>
                            <td>
                                <span class="w-fixC-50">
                                    @if (@item["Pic"].ToString() == "")
                                    {
                                        <img src="/Uploads/Persons/K_0.jpg" alt="سرمد - @item["KarbarName"]" class="w-100 cursor-pointer rounded rounded-5" />
                                    }
                                    else
                                    {
                                        <div class="w-fix-50 cursor-pointer" onclick="Zoom(this);">
                                            <img src="/Uploads/Persons/K_@item["Si_Person"]_@item["Pic"]" alt="سرمد - @item["KarbarName"]" class="w-100 cursor-pointer rounded rounded-5" />
                                        </div>
                                    }
                                </span>
                            </td>
                            <td><span class="w-fixC-50">@item["Cu_Person"]</span></td>
                            <td><span class="w-fixC-200">@item["KarbarName"]</span></td>
                            <td><span class="w-fixC-125">@item["UserName"]</span></td>
                            <td class="text-center">
                                <button type="button" class="btn_Icon Icon_Mor icofont-00x icofont-edit" title="ویرایش" onclick="ClickBtnSimpl('FormSabtKarbaranBtn', '@item["Si_Person"]');"></button>
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn_Icon Icon_Brown icofont-00x icofont-cubes" title="تخصیص ها" onclick="ClickBtnSimpl('FormSabtAccessBtn','@item["Si_Person"]');"></button>
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn_Icon Icon_Red icofont-00x icofont-bin" title="حذف" onclick="ClickBtnSimpl('KarbarDeletBtn', '@item["Si"]', 'KarbarDeletPer', '@item["Si_Person"]');"></button>
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn_Icon Icon_Orang icofont-00x icofont-rotate-180 icofont-sign-in" title="ورود به پنل کلاینت" onclick="ClickBtnSimpl('GoToUserSystemBtn', '@item["Si_Person"]');"></button>
                            </td>
                            <td class="ltr"><span class="w-fixC-200">@item["LastLoginAt"]</span></td>
                            <td>
                                @if (@item["IsActive"].ToString() == "Y")
                                {
                                    <img class="w-fix-50" src="/images/Btn_Yes.png" alt="Sarmad_YesNo" />
                                }
                                else
                                {
                                    <img class="w-fix-50" src="/images/Btn_No.png" alt="Sarmad_YesNo" />
                                }
                            </td>
                            <td><span class="w-fixC-300">@item["Sharh"]</span></td>
                            <td><button type="button" class="BTN btn_Pill btn_Firuze w-fixC-140" onclick="ClickBtnSimpl('LastVisit_IPBtn', '@item["Si_Person"]');">@item["LastLoginIP"]</button> </td>
                            <td><span class="w-fixC-100">@item["DateStart"]</span></td>
                            <td><span class="w-fixC-180 text-start"><span>@item["Editor"]</span><span class="text_line23">@item["TimeEdit"]</span></span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div hidden>
            <form hidden asp-antiforgery="true" method="post" data-ajax="true" data-ajax-method="post"
                  data-ajax-confirm="آیا کاربری این شخص حذف گردد؟"
                  data-ajax-Btn="KarbarDeletBtn"
                  data-ajax-begin="SpinnerShowForm('چند لحظه صبر کنید');"
                  data-ajax-url="?handler=DeleteKarbar"
                  data-ajax-complete="CompleteResult"
                  data-ajax-success="AreaHide('User_'+EleValue('KarbarDeletBtn'))">
                <input type="hidden" id="KarbarDeletPer" name="IDPerson" />
                <input type="submit" hidden id="KarbarDeletBtn" name="ID" />
            </form>
            <form hidden asp-antiforgery="true" method="post" data-ajax-method="post" data-ajax="true"
                  data-ajax-confirm="آیا میخواهید وارد پنل کاربر بشوید؟"
                  data-ajax-Btn="GoToUserSystemBtn"
                  data-ajax-begin="SpinnerShowForm('چند لحظه صبر کنید. ...');"
                  data-ajax-url="?handler=GoToUserSystem"
                  data-ajax-complete="GoToUserSystemComplete_10">
                <input type="submit" id="GoToUserSystemBtn" name="UserId" hidden value="0" />
            </form>

            <form method="get" data-ajax="true" data-ajax-method="get"
                  data-ajax-begin="MsgFormSpinner('B','ویرایش تخصیص های به کاربر', 'چند لحظه صبر کنید');"
                  data-ajax-url="?handler=FormSabtAccess"
                  data-ajax-update="#MsgForm_B_MATN">
                <input type="submit" hidden id="FormSabtAccessBtn" name="IDPerson" />
            </form>

            <form hidden method="get" data-ajax="true" data-ajax-method="get"
                  data-ajax-begin="MsgFormSpinner('A','سابقه ورود به سیستم', 'چند لحظه صبر کنید');"
                  data-ajax-url="?handler=LastVisit_IP"
                  data-ajax-update="#MsgForm_A_MATN">
                <input type="submit" id="LastVisit_IPBtn" name="IDPerson" value="0" hidden />
            </form>

        </div>

        break;

    case "LastVisit_IP":
        <div class="secondArea w-min-350">
            <h4 class="alert alert-danger">آخرین ورودها</h4>
            @foreach (DataRow item in Model.ListData.Rows)
            {
                { RJ++; }
                <div><span class="text-brown">@RJ --> </span> @item["FullData"]</div>
                <hr />
            }
        </div>

        break;

    case "FormSabtAccess":
        <div class="d-flex justify-content-center flex-wrap gap-2 py-3">
            <button type="button" class="BTN btn_Pill btn_Firuze w-fix-200" onclick="ClickBtnSimpl('AccessAreaBtn','A')">فرمهای بدون دسترسی</button>
            <button type="button" class="BTN btn_Pill btn_Firuze w-fix-200" onclick="ClickBtnSimpl('AccessAreaBtn','B')">فرمهای فعال کاربر</button>
            <button type="button" class="BTN btn_Pill btn_Firuze w-fix-150" onclick="ClickBtnSimpl('AccessAreaBtn','C')">جانشین ها</button>
        </div>
        <div id="AccessArea">
        </div>
        <div hidden>
            <form hidden asp-antiforgery="true" method="get" data-ajax-method="get" data-ajax="true"
                  data-ajax-begin="SpinnerShow('AccessArea','چند لحظه صبر کنید. ...');"
                  data-ajax-url="?handler=AccessAreaInfo"
                  data-ajax-update="#AccessArea">
                <input type="hidden" name="IdPerson" value="@ViewData["ID"]" />
                <input type="submit" id="AccessAreaBtn" name="Act" hidden value="A" />
            </form>

            <form hidden asp-antiforgery="true" method="post" data-ajax-method="post" data-ajax="true"
                  data-ajax-confirm="آیا دسترسی به فرمها آپدیت شود؟"
                  data-ajax-Btn="UpdateAccessFormBtn"
                  data-ajax-begin="SpinnerShow('listFormsArea','چند لحظه صبر کنید. ...');"
                  data-ajax-url="?handler=UpdateAccessForm"
                  data-ajax-complete=" AreaHide('FRM_'+EleValue('UpdateAccessFormBtn'));">
                <input type="hidden" name="IdPerson" value="@ViewData["ID"]" />
                <input type="submit" id="UpdateAccessFormBtn" name="IdForm" hidden value="0" />
            </form>

        </div>

       break;

    case "Access_NotForms":
        <div class="secondAreaSection w-max-500 mx-auto">
            <div class="alert alert-primary">فرمهای بدون دسترسی</div>
            <div class="gap-2">
                @foreach (DataRow item in Model.ListForms.Rows)
                {
                    { RJ++; ZF = (ZF == "Fard") ? "Zoj" : "Fard"; }
                    <button class="@ZF p-2 cursor-pointer btn_Pill w-100" id="FRM_@item["Si"]" title="اجازه دسترسی به @item["onvan"]" onclick="ClickBtnSimpl('UpdateAccessFormBtn', '@item["Si"]');">
                        <div class="d-flex">
                            <div class="flex-fill text-start">
                                <span class="text-danger mx-2 ">@RJ -</span>
                                <span>@item["onvan"] - @item["Tp"]</span>
                            </div>
                            <span class="icofont icofont-2x icofont-verification-check text-primary"></span>

                        </div>
                    </button>
                }

            </div>
        </div>
        break;

    case "Access_ActiveForms":
        <div class="secondAreaSection w-max-500 mx-auto">
            <div class="alert alert-primary">فرمهای فعال کاربر</div>
            <div class="gap-2">
                @foreach (DataRow item in Model.ListForms.Rows)
                {
                    { RJ++; ZF = (ZF == "Fard") ? "Zoj" : "Fard"; }
                    <button class="@ZF p-2 m-1 cursor-pointer btn_Pill w-100" id="FRM_@item["Si"]" title="دسترسی حذف شود @item["onvan"]" onclick="ClickBtnSimpl('UpdateAccessFormBtn', '@item["Si"]');">
                        <div class="d-flex">
                            <div class="flex-fill text-start">
                                <span class="text-danger mx-2 ">@RJ -</span>
                                <span>@item["onvan"] - @item["Tp"]</span>
                            </div>
                            <span class="icofont icofont-2x icofont-close text-danger"></span>
                        </div>
                    </button>
                }

            </div>
        </div>
        break;



    case "Access_Standby":
        <div class="secondAreaSection w-max-500 mx-auto">
            <div class="alert alert-primary">جانشین ها</div>

            <div class="alert alert-danger">در حال طراحی</div>
        </div>
        break;


    case "FormSabtPerson":
        <section class="">
            <div class="secondAreaSection w-min-mediaForm">
                <form asp-antiforgery="true" method="post" data-ajax-method="post" data-ajax="true"
                      data-ajax-confirm="ذخیره اطلاعات شخص انجام گردد؟"
                      data-ajax-Btn="UpdatePersonBtn"
                      data-ajax-begin="SpinnerShowForm('چند لحظه صبر کنید');"
                      data-ajax-url="?handler=UpdatePerson"
                      data-ajax-complete="JsonClose_A">
                    <input type="hidden" name="ID" value="@ViewData["ID"]" />
                    @if(@ViewData["ID"].ToString() == "0")
                    {
                        <div class="row">
                            <div class="col-12 col-md-6">
                                <div class="d-flex">
                                    <div class="m-2 w-fix-100">
                                        <span class="control-label">نوع</span>
                                        <select name="Kind" class="control-input">
                                            <option value="1">حقیقی</option>
                                            <option value="2" selected>حقوقی</option>
                                        </select>
                                    </div>
                                    <div class="m-2 flex-fill">
                                        <span class="control-label">کد</span>
                                        <input type="tel" onkeyup="onlyNumber(this)" name="Code" class="control-input ltr text-center" maxlength="10" value="@ViewData["NewCu"]">
                                    </div>
                                    <div class="m-2 w-fix-100">
                                        <span class="control-label">وضعیت</span>
                                        <select name="Act" class="control-input">
                                            <option value="Y">فعال</option>
                                            <option value="N">غیر فعال</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row py-1">
                                    <div class="col-6">
                                        <span class="control-label">نام</span>
                                        <input type="text" name="FName" class="control-input text-center" maxlength="30" value="شرکت" />
                                    </div>
                                    <div class="col-6">
                                        <span class="control-label">نام خانوادگی/نام شرکت/موسسه</span>
                                        <input type="text" name="LName" class="control-input text-center" maxlength="50" />
                                    </div>
                                </div>
                                <div class="row py-1">
                                    <div class="col-6">
                                        <span class="control-label">کد/شناسه ملی</span>
                                        <input type="tel" onkeyup="onlyNumber(this)" name="CodeMeli" class="control-input ltr text-center" maxlength="11">
                                    </div>
                                    <div class="col-6">
                                        <span class="control-label">مسئول پاسخگو</span>
                                        <input type="text" name="Responsible" class="control-input text-center" maxlength="30" value="" />
                                    </div>
                                </div>

                                <div class="row py-1">
                                    <div class="col-6">
                                        <span class="control-label">موبایل</span>
                                        <input type="tel" onkeyup="onlyNumber(this)" name="Mobile" class="control-input text-center ltr" maxlength="15" />
                                    </div>
                                    <div class="col-6">
                                        <span class="control-label">ایمیل</span>
                                        <input type="email" name="Email" class="control-input ltr" maxlength="50" />
                                    </div>
                                </div>
                                <div class="row py-1">
                                    <div class="col-6">
                                        <span class="control-label">تلفن</span>
                                        <input type="tel" onkeyup="onlyNumber(this)" name="Phone" class="control-input ltr text-center" maxlength="15" />
                                    </div>
                                    <div class="col-6">
                                        <span class="control-label">کدپستی</span>
                                        <input type="text" name="Post" class="control-input text-center" maxlength="15" />
                                    </div>
                                </div>

                                <div class="mb-2">
                                    <span class="control-label">شهر</span>
                                    <div class="d-flex">
                                        <select id="SabtPerson_City" name="City" class="control-input">
                                            <option value="0">شهر را انتخاب کنید</option>
                                            @foreach (DataRow item in Model.ListData.Rows)
                                            {
                                                <option value="@item["Si"]">@item["Ostan"] --> @item["City"]</option>
                                            }
                                        </select>
                                        <button type="button" onclick="ClickBtn('FormNewCityBtn');" class="btn_Icon Icon_Yellow icofont-2x icofont-plus-square" title="افزودن شهر جدید"></button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="mb-2">
                                    <span class="control-label">گروه</span>
                                    <div class="row">
                                        @foreach (DataRow item in Model.ListGRP.Rows)
                                        {
                                            <div class="col-12 col-sm-6 mt-1">
                                                <div class="d-flex justify-content-between p-1 border-bottom">
                                                    <span class="control-label">@item["Sharh"]</span>
