@model Sarmad.Pages.Dayli.MsgCenterModel
@using System.Web;
@using System.Data;
@{
    var RJ = 0;
    var ZF = "";
}
@switch (@ViewData["Switch"])
{
    case "ListMokhatab":
        <div class="row">
            @if(ViewData["KND"].ToString() !="ADD")
            {
                @if (@ViewData["TAKGRP"].ToString() == "TAK")
                {
                    @foreach (DataRow item in Model.ListKarbaran.Rows)
                    {
                        <div class="col-12 col-sm-6">
                            <div class="areaKarbar cursor-pointer" title="انتخاب مخاطب" onclick="SelectPerson_3('@ViewData["KND"]', '@item["Si"]', '@item["Pic"]', '@item["KarbarName"]', ' @item["Semat"]'); RowSelect(this); AreaUp('ModalForm_B');  AreaClear('MsgForm_B_MATN');">
                                <div class="PicKarbar colorSecondary">
                                    @if (@item["Pic"].ToString() != "")
                                    {
                                        <img src="/Uploads/Persons/@item["Pic"]" class="rounded rounded-5 w-fix-50 h-fix-50" />
                                    }
                                    else
                                    {
                                        <img src="/Uploads/Persons/P_0.jpg" class="rounded rounded-5 w-fix-50 h-fix-50" />
                                    }
                                </div>
                                <div class="InfoKarbar">
                                    <span class="control-label">
                                        <span class="text-white-50">سمت: </span><span> @item["Semat"]</span>
                                    </span>
                                    <div class="colorSecondary">
                                        @item["KarbarName"]
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class=" text-end">
                        <button class="BTN btn_Pill btn_Blue2 w-fix-100" onclick="SelectAllMokhatab_3('@Model.ListKarbaran.Rows.Count');">انتخاب همه </button>
                    </div>
                    RJ = 0;
                    @foreach (DataRow item in Model.ListKarbaran.Rows)
                    {
                        <div class="col-12 col-sm-6">
                            <div id="ListMokhatab_@RJ" class="areaKarbar cursor-pointer" title="انتخاب مخاطب" onclick="SelectPerson_3('@ViewData["KND"]', '@item["Si"]', '@item["Pic"]', '@item["KarbarName"]', ' @item["Semat"]'); RowSelect(this);">
                                <div class="PicKarbar colorSecondary">
                                    @if (@item["Pic"].ToString() != "")
                                    {
                                        <img src="/Uploads/Persons/@item["Pic"]" class="rounded rounded-5 w-fix-50 h-fix-50" />
                                    }
                                    else
                                    {
                                        <img src="/Uploads/Persons/P_0.jpg" class="rounded rounded-5 w-fix-50 h-fix-50" />
                                    }
                                </div>
                                <div class="InfoKarbar">
                                    <span class="control-label">
                                        <span class="text-white-50">سمت: </span><span> @item["Semat"]</span>
                                    </span>
                                    <div class="colorSecondary text-start">
                                        <span>@item["KarbarName"]</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        RJ++;
                    }
                }
            }
            else{
                @foreach (DataRow item in Model.ListKarbaran.Rows)
                {
                    <div class="col-12 col-sm-6">
                        <div title="انتخاب مخاطب" onclick="AddPerson_3('@item["Si"]', '@item["Pic"]', '@item["KarbarName"]', ' @item["Semat"]');">
                            <div id="ReplyListMokhatab_@item["Si"]">
                                <div class="areaKarbar cursor-pointer">
                                    <div class="PicKarbar colorSecondary">
                                        @if (@item["Pic"].ToString() != "")
                                        {
                                            <img src="/Uploads/Persons/@item["Pic"]" class="rounded rounded-5 w-fix-50 h-fix-50" />
                                        }
                                        else
                                        {
                                            <img src="/Uploads/Persons/P_0.jpg" class="rounded rounded-5 w-fix-50 h-fix-50" />
                                        }
                                    </div>
                                    <div class="InfoKarbar">
                                        <span class="control-label">
                                            <span class="text-white-50">سمت: </span><span> @item["Semat"]</span>
                                        </span>
                                        <div class="colorSecondary text-start">
                                            <span>@item["KarbarName"]</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        break;


    case "MsgReports":
        <div class="d-flex flex-wrap justify-content-between border-top border-secondary">
            <div class="Area_Count w-fix-200">
                <span>تعداد : </span><span>@Model.ListData.Rows.Count </span>
            </div>
            <div class="flex-fill text-end">
                <div class="Area_Print w-max-350">
                    <form method="post" data-ajax-method="post" data-ajax="true"
                        data-ajax-begin="SpinnerShowForm('در حال آماده سازی فایل گزارش');"
                        data-ajax-url="?handler=Chap_@ViewData["Switch"]"
                        data-ajax-complete="ControlChap('Chap_@ViewData["Switch"]Btn');">
                        <input type="hidden" name="ComText" value="@ViewData["ComText"]" />
                        <input type="submit" hidden id="Chap_@ViewData["Switch"]Btn" name="Chap" value="" />
                        <div class="d-flex p-2 pb-0 justify-content-end">
                            <input class="control-input w-100" name="OnvanChap" placeholder="عنوانی برای چاپ بنویسید" value="" />
                            <button type="button" title="چاپ" class="btn_Icon Icon_Gray icofont-2x icofont-print" onclick="ClickBtnSimpl('Chap_@ViewData["Switch"]Btn', 'CHAP');"></button>
                            <button type="button" title="پی دی اف" class="btn_Icon Icon_Gray icofont-2x icofont-file-pdf" onclick="ClickBtnSimpl('Chap_@ViewData["Switch"]Btn', 'PDF');"></button>
                            <button type="button" title="اکسل" class="btn_Icon Icon_Gray icofont-2x icofont-file-excel" onclick="ClickBtnSimpl('Chap_@ViewData["Switch"]Btn', 'XLS');"></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>


        <div class="header_Table">
            <button type="button" class="btn_Icon footer_Right Icon_Red icofont-00x icofont-curved-double-right" title="اسکرول به راست" onclick="ScrollRight('@ViewData["Switch"]_FT');"></button>
            <button type="button" class="btn_Icon footer_Left Icon_Red icofont-00x icofont-curved-double-left" title="اسکرول به چپ" onclick="ScrollLeft('@ViewData["Switch"]_FT');"></button>
            <div id="@ViewData["Switch"]_FT" class="overflow-hidden" onscroll="ScrollSlave(this, '@ViewData["Switch"]_MS');">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th><span>#</span></th>
                            <th><span class="w-fix-200"> مخاطب</span></th>
                            <th><span class="w-fix-50">صندوق</span></th>
                            <th><span class="w-fix-300">موضوع</span></th>
                            <th><span class="w-fix-50">نمایش</span></th>
                            <th><span class="w-fix-50">پین</span></th>
                            @if (ViewData["KndReport"].ToString() == "Detail"){
                                <th><span class="w-fix-50">جدید</span></th>
                            }
                            <th><span class="w-fix-350">پیام</span></th>
                            <th><span class="w-fix-50">نوع</span></th>
                            <th><span class="w-fix-50">وضعیت</span></th>
                            <th><span class="w-fix-50">پیامک</span></th>
                            <th><span class="w-fix-100">مرجع</span></th>
                            <th><span class="w-fix-180">زمان</span></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
        <div class="overflow-auto" id="@ViewData["Switch"]_MS" onscroll="ScrollSlave(this, '@ViewData["Switch"]_FT');">
            <table class="table">
                <thead class="header_Tablehiden">
                    <tr>
                        <th><span>#</span></th>
                        <th><span class="w-fix-200"> مخاطب</span></th>
                        <th><span class="w-fix-50">صندوق</span></th>
                        <th><span class="w-fix-300">موضوع</span></th>
                        <th><span class="w-fix-50">نمایش</span></th>
                        <th><span class="w-fix-50">پین</span></th>
                        @if (ViewData["KndReport"].ToString() == "Detail")
                        {
                            <th><span class="w-fix-50">جدید</span></th>
                        }
                        <th><span class="w-fix-350">پیام</span></th>
                        <th><span class="w-fix-50">نوع</span></th>
                        <th><span class="w-fix-50">وضعیت</span></th>
                        <th><span class="w-fix-50">پیامک</span></th>
                        <th><span class="w-fix-100">مرجع</span></th>
                        <th><span class="w-fix-180">زمان</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DataRow item in Model.ListData.Rows)
                    {
                        { RJ++;  }
                        <tr onclick="RowSelect(this);">
                            <td class="text-danger">@RJ</td>

                            @if (@item["Id_User"].ToString() != ViewData["UserSi"].ToString())
                            {
                                <td>
                                    <span class="w-fixC-200 d-flex">
                                        <img class="rounded rounded-5 w-fix-50 h-fix-50" src="/Uploads/Persons/@item["PicWriter"]" />
                                        <div class="ps-2 pt-3">
                                            <span> @item["NameWriter"]</span>
                                        </div>
                                    </span>
                                </td>
                                <td>
                                    <span class="w-fixC-50 btn_Icon Icon_Mor icofont-2x icofont-hand-left" title="صندوق ورودی"></span>
                                </td>
                            }
                            else{
                                <td>
                                    <span class="w-fixC-200 d-flex">
                                        <img class="rounded rounded-5 w-fix-50 h-fix-50" src="/Uploads/Persons/@item["PicMokhatab"]" />
                                        <div class="ps-2 pt-3">
                                            <span> @item["NameMokhatab"]</span>
                                        </div>
                                    </span>
                                </td>
                                <td>
                                    <span class="w-fixC-50 btn_Icon Icon_Blue icofont-2x icofont-hand-right" title="صندوق ارسالی"></span>
                                </td>
                            }
                            <td><span class="w-fixC-300 text-start">@item["Onvan"]<span class="text_line24 font-14">@item["Owner"]</span></span></td>
                            <td><span class="w-fixC-50"><button type="button" class="btn_Icon Icon_Mor icofont-2x icofont-list" title="نمایش گفتگوها" onclick="ClickBtnSimpl('MsgDtListBtn', '@item["Id_Hd"]', 'MsgDtOrder', 'Desc');"></button></span></td>
                            <td>
                                <span class="w-fixC-50">
                                @if (@item["Pin"].ToString() == "Y")
                                {
                                    <button type="button" class="btn_Icon Icon_Orang icofont-2x icofont-tack-pin" title="پین شده" onclick="ClickBtnSimpl('ChangPinBtn', '@item["Id_Hd"]'); ChangIcon(this, 'Icon_Orang', 'Icon_Gray');"></button>
                                }
                                else
                                {
                                    <button type="button" class="btn_Icon Icon_Gray icofont-2x icofont-tack-pin" title="پین شود" onclick="ClickBtnSimpl('ChangPinBtn', '@item["Id_Hd"]'); ChangIcon(this, 'Icon_Orang', 'Icon_Gray');"></button>
                                }
                                </span>
                            </td>
                            @if (ViewData["KndReport"].ToString() == "Detail")
                            {
                                <td>
                                    <span class="w-fixC-50">
                                    @if (@item["Id_User"].ToString() != ViewData["UserSi"].ToString())
                                    {
                                        @if (@item["New"].ToString() == "Y")
                                        {
                                            <button type="button" class="btn_Icon Icon_Orang icofont-2x icofont-alarm" title="خوانده شد" onclick="ClickBtnSimpl('MsgReadBtn', '@item["Si"]'); ChangIcon(this, 'Icon_Orang', 'Icon_Gray');"></button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn_Icon Icon_Gray icofont-2x icofont-alarm" title="خوانده شده"></button>
                                        }
                                    }
                                    else
                                    {
                                        <button type="button" class="btn_Icon Icon_Gray icofont-2x icofont-alarm" title="خوانده شده"></button>
                                    }
                                    </span>
                                </td>
                            }
                            <td><span class="w-fixC-350 h-max-200 scrollAmudi">@Html.Raw(HttpUtility.HtmlDecode(@item["Matn"].ToString()))</span></td>
                            <td>
                                <span class="w-fixC-50">
                                    @if (@item["Knd"].ToString() == "P")
                                    {
                                        <span class="icofont icofont-2x icofont-user-alt-2 text-primary" title="پرونده دونفره"></span>
                                    }
                                    else
                                    {
                                        @if (@item["Knd"].ToString() == "G")
                                        {
                                            <span class="icofont icofont-2x icofont-users-alt-2 text-primary" title="پرونده گروهی"></span>
                                        }
                                        else
                                        {
                                            @if (@item["Knd"].ToString() == "F")
                                            {
                                                <span class="icofont icofont-2x icofont-business-man text-success" title="گفتگوی آزاد"></span>
                                            }
                                            else
                                            {
                                                <span class="icofont icofont-2x icofont-automation text-primary" title="پرونده سیستمی"></span>
                                            }
                                        }
                                    }
                                </span>
                            </td>
                            <td>
                                <span class="w-fixC-50">
                                    @if (@item["Active"].ToString() == "Y")
                                    {
                                        <button type="button" class="btn_Icon Icon_Green icofont-2x icofont-unlocked" title="گفتگو فعال است. بایگانی شود" onclick="ClickBtnSimpl('ChangActBtn', '@item["Id_Hd"]'); ChangIcon(this, 'text-danger', 'text-primary');"></button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn_Icon Icon_Gray icofont-2x icofont-lock" title="گفتگو بایگانی شده است. فعال شود" onclick="ClickBtnSimpl('ChangActBtn', '@item["Id_Hd"]'); ChangIcon(this, 'text-danger', 'text-primary');"></button>
                                    }

                                </span>
                            </td>
                            <td>
                                <span class="w-fixC-50">
                                    @if (@item["Id_User"].ToString() == ViewData["UserSi"].ToString())
                                    {
                                        <button type="button" class="btn_Icon Icon_Blue icofont-2x icofont-send-mail" title="ارسال پیامک" onclick="ClickBtnSimpl('SndSmsBtn', '@item["Id_Hd"]');"></button>
                                    }
                                </span>
                            </td>
                            <td><span class="w-fixC-100">@item["Ref"]/@item["Ref_Id"]</span></td>
                            <td><span class="w-fixC-180 ltr">@item["TimeWrite"]</span></td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>

        <form hidden asp-antiforgery="true" method="post" data-ajax="true" data-ajax-method="post"
              data-ajax-confirm="آیا این پیام برای مخاطب پیامک شود؟ "
              data-ajax-Btn="SndSmsBtn"
              data-ajax-begin="SpinnerShowForm('چند لحظه صبر کنید');"
              data-ajax-url="?handler=SndSms"
              data-ajax-complete="CompleteResult">
            <input type="submit" hidden name="HDID" value="0" id="SndSmsBtn" />
        </form>
        <form hidden asp-antiforgery="true" method="post" data-ajax="true" data-ajax-method="post"
              data-ajax-url="?handler=ChangPin">
            <input type="submit" hidden name="Id_Msg" value="0" id="ChangPinBtn" />
        </form>

        <form hidden asp-antiforgery="true" method="post" data-ajax="true" data-ajax-method="post"
              data-ajax-confirm="آیا از تغییر وضعیت این گفتگو مطمئن هستید"
              data-ajax-Btn="ChangActBtn"
              data-ajax-begin="SpinnerShowForm('چند لحظه صبر کنید');"
              data-ajax-url="?handler=ChangAct"
              data-ajax-complete="CompleteResult">
            <input type="submit" hidden name="ID" value="0" id="ChangActBtn" />
        </form>

        break;



    case "ReplyList":

        <div class="reportfilter mt-3">
            <div class="text-start text-white-50">موضوع گفتگو:</div>
            <h4 class="text-Yellow">@Model.RowData["Onvan"]</h4>
        </div>

        <div class="d-flex flex-wrap">
            @if (@Model.RowData["Knd"].ToString() != "F"){
                <div class="w-max-350 p-1">
                    <div class="areaKarbar">
                        <div class="PicKarbar colorPrimary"><img src="/Uploads/Persons/@Model.RowData["PicOwner"]" class="" /> </div>
                        <div class="InfoKarbar">
                            <span class="control-labelDark">مجری:</span>
                            <div class="colorPrimary">@Model.RowData["Owner"]</div>
                        </div>
                    </div>
                </div>
            }
            @if (@Model.ListKarbaran.Rows.Count > 2 ){
                <div class="flex-fill pt-sm-5 px-2">
                    <div class="text-end pe-3">
                        <button id="ReplayNewBtn" type="button" class="Btn btn_Top btn_Gray py-1 w-fix-250"
                                onclick="AreaToggel('AreaMokhatabReplyList'); ChangIcon('iconMokatabUpDown', 'icofont-expand-alt', 'icofont-collapse');">
                            <span>نمایش لیست مخاطبین</span>
                            <span id="iconMokatabUpDown" class="icofont-2x icofont-expand-alt float-end"></span>
                        </button>
                    </div>
                    <div id="AreaMokhatabReplyList" class="ReportSaz">
                        <div class="flex-fill d-flex flex-wrap justify-content-center" id="MokhatabReplyList">
                            @foreach (DataRow item in Model.ListKarbaran.Rows)
                            {
                                if (@item["Si"].ToString() != Model.RowData["Id_Owner"].ToString())
                                {
                                    <div class="w-max-350 p-1" id="ReplyListMokhatab_@item["Si"].ToString()">
                                        <div class="areaKarbar">
                                            <div class="PicKarbar colorSecondary"><img src="/Uploads/Persons/@item["PicUser"]" class="" /> </div>
                                            <div class="InfoKarbar">
                                                <span class="control-label"></span>
                                                <div class="colorSecondary">
                                                    @item["FullName"]
                                                    @if (@item["Si"].ToString() == ViewData["UserSi"].ToString())
                                                    {
                                                        <button type="button" class="btn_Icon btn_Pill  p-0 float-end Icon_Red icofont-2x icofont-delete" title="ترک گفتگو" onclick="ClickBtnSimpl('DeletMokhatabBtn','@item["Si"]')"></button>
                                                    }

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="flex-fill" id="MokhatabReplyList">
                    @if (@Model.RowData["Knd"].ToString() == "F")
                    {
                        @foreach (DataRow item in Model.ListKarbaran.Rows)
                        {
                            @if (@item["Si"].ToString() != ViewData["UserSi"].ToString())
                            {
                                <div class="w-max-350 p-1" id="ReplyListMokhatab_@item["Si"].ToString()">
                                    <div class="areaKarbar">
                                        <div class="PicKarbar colorSecondary"><img src="/Uploads/Persons/@item["PicUser"]" class="" /> </div>
                                        <div class="InfoKarbar">
                                            <span class="control-label"></span>
                                            <div class="colorSecondary">
                                                @item["FullName"]
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                       }
                    }
                    else{
                        @foreach (DataRow item in Model.ListKarbaran.Rows)
                        {
                            if (@item["Si"].ToString() != Model.RowData["Id_Owner"].ToString())
                            {
                                <div class="w-max-350 p-1" id="ReplyListMokhatab_@item["Si"].ToString()">
                                    <div class="areaKarbar">
                                        <div class="PicKarbar colorSecondary"><img src="/Uploads/Persons/@item["PicUser"]" class="" /> </div>
                                        <div class="InfoKarbar">
                                            <span class="control-label"></span>
                                            <div class="colorSecondary">
                                                @item["FullName"]
                                                @if (@item["Si"].ToString() == ViewData["UserSi"].ToString())
                                                {
                                                    <button type="button" class="btn_Icon btn_Pill  p-0 float-end Icon_Red icofont-00x icofont-delete" title="ترک گفتگو" onclick="ClickBtnSimpl('DeletMokhatabBtn','@item["Si"]')"></button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
           
                </div>
            }
        </div>


        <div class="filterArea">
            <div class="d-flex justify-content-between">
                @if (@Model.RowData["Knd"].ToString() == "S")
                {
                    <div>
                        <span class="text-danger icofont-2x icofont-bell-alt"></span>
                        <span class="">پرونده سیستمی </span>
                    </div>
                }
                else
                {
                    @if (Model.RowData["Active"].ToString() == "Y")
                    {
                        <button id="ReplayNewBtn" type="button" class="ms-3 Btn btn_Top btn_Gray py-1 w-fix-150"
                        onclick="AreaToggel('AreaReplyMsg'); ChangIcon('iconRepUpDown', 'icofont-expand-alt', 'icofont-collapse');">
                            <span>نوشتن پاسخ</span>
                            <span id="iconRepUpDown" class="icofont-2x icofont-expand-alt float-end"></span>
                        </button>
                    }
                    else
                    {
                        <div>
                            <span class="text-danger icofont-2x icofont-bell-alt"></span>
                            <span class="">این گفتگو بایگانی شده است و امکان ارسال پیام در آن را ندارید </span>
                        </div>
                    }
                }

                @if (Model.RowData["Id_Owner"].ToString() == @ViewData["UserSi"].ToString() || Model.RowData["MNG"].ToString() == "1")
                {
                    <form method="get" data-ajax="true" data-ajax-method="get"
                          data-ajax-begin="MsgFormSpinner('A','افزودن مخاطب به گفتگو', 'چند لحظه صبر کنید');"
                          data-ajax-url="?handler=FormAddMokhatab"
                          data-ajax-update="#MsgForm_A_MATN">
                        <input type="hidden" name="OWNER" value="@Model.RowData["Id_Owner"]" />
                        <input type="hidden" name="HDID" value="@Model.RowData["Si"]" />
                        <button type="submit" class="Btn btn_Normal btn_Blue w-fix-150">
                            <span>افزودن مخاطب</span>
                            <i class="icofont-2x icofont-plus"></i>
                        </button>
                    </form>
                }
            </div>

            @if (Model.RowData["Active"].ToString() == "Y")
            {
                <div id="AreaReplyMsg" class="ReportSaz">
                    <form asp-antiforgery="true" method="post" data-ajax="true" data-ajax-method="post"
                          enctype="multipart/form-data"
                          data-ajax-begin="SpinnerShow('MsgReplyList');"
                          data-ajax-url="?handler=ReplyMsg"
                          data-ajax-update="#MsgReplyList">
                        <input type="hidden" name="HDID" value="@Model.RowData["Si"]" />
                        <input class="d-none" type="file" id="ReplyFileUpload" name="FileUpload" accept=".jpg, .png, .bmp, .jpeg, .pdf, .txt, .xls, .xlsx, .doc, .docx, .zip, .rar" onchange="GetFile(this,'ReplyFileName', 'ReplyFileKnd');" />

                        <div class="mb-2 text-start">
                            <span class="control-label">شرح پیام</span>
                            <textarea class="control-input-Area h-fix-200" id="MsgMatnRep" name="MsgMatn"></textarea>
                        </div>
                        <div class="d-flex justify-content-around">
                            <button type="button" id="ReplyFileKnd" class="btn_Icon Icon_White icofont-3x icofont-upload" onclick="ClickBtnSimpl('ReplyFileUpload', '');" title="نوع فایل انتخاب شده"></button>
                            <div class="flex-fill">
                                <span class="control-label">پیوست</span>
                                <div class="d-flex">
                                    <span id="ReplyFileName" class="control-text mx-3"></span>
