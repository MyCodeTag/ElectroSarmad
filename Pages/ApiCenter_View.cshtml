                        <h5 class="text-primary font-bold mt-2">@LST.A</h5>
                        <span id="hlpIcn_@LST.E" class="text-brown icofont-2x my-auto icofont-caret-down"></span>
                    </div>
                    <div class="pb-5 dis-none RawImg" id="Cont_@LST.E">
                        <div>@Html.Raw(HttpUtility.HtmlDecode(LST.B))</div>
                    </div>
                }
 *@            </div>
        </div>
        break;

    case "Select":
@*         @foreach (var K in Model.AE_List)
        {
            <option value="@K.A">@K.B</option>
        }
 *@        break;

    case "ListKala":
        @if (Model.ListData.Rows.Count==0){
            <option value="" disabled selected data-Vahed="">کالایی پیدا نشد</option>
        }else{
            <option value="" disabled selected data-Vahed="">انتخاب کنید --> @Model.ListData.Rows.Count کالا</option>
            @if (ViewData["Sort"].ToString() == "Code")
            {
                @foreach (DataRow item in Model.ListData.Rows)
                {
                    <option value="@item["Si"]" data-Vahed="@item["Vahed"]" data-Code="@item["Code"]">@item["Code"] - (@item["KalaName"])</option>
                }
            }
            else
            {
                @foreach (DataRow item in Model.ListData.Rows)
                {
                    <option value="@item["Si"]" data-Vahed="@item["Vahed"]" data-Code="@item["Code"]">@item["KalaName"] - (@item["Code"])</option>
                }
            }
        }
    break;

