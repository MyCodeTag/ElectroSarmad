<div class="p-1">
    <span class="control-label">عنوان</span>
    <div class="control-input d-flex justify-content-between">
        <label for="C_All"><input type="checkbox" id="C_All" checked onclick="CheckAllOnvan_31()" /> همه</label>
        <label for="C_Tan"><input type="checkbox" id="C_Tan" onclick="SelectOnvan_31('178');" /> تنخواه</label>

        <button type="button" id="iconOnvan" class="icofont-00x icofont-circled-down" onclick="AreaToggel('OnvanList'); ChangIcon('iconOnvan', 'icofont-circled-down', 'icofont-circled-up');"></button>
        <input type="hidden" id="Onvan" name="IdDP" value=",@foreach (var H in Model.IdValueTp_List){@if (@H.Reg == "HAZ" || @H.Reg == "DAR"){ @if (@H.Id != "178"){@H.Tp}}}" />
    </div>
    <div id="OnvanList" class="checkboxes text-start">
        @foreach (var H in Model.IdValueTp_List)
        {
            @if (@H.Reg == "HAZ" || @H.Reg == "DAR")
            {
                @if (@H.Id != "178")
                {
                    <label for="C_@H.Id"><input type="checkbox" id="C_@H.Id" checked onclick="SelectOnvan_31('@H.Id');" /> @H.Value</label>
                }
            }
        }
    </div>
</div>




