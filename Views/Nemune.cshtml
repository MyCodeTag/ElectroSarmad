        public async Task<IActionResult>
    OnPostChap_RepHd(string ComText = "", string Chap = "0", string OnvanChap = "")
    {
    try
    {
                string FileName = Center.FilePath(_hostingEnvironment.WebRootPath, VU, Request.Cookies["User.Sarmad.ir"], Chap);

    var ListPrint = await DBS.GetReportDataAsync(ComText);

    OnvanChap = (Center.TrimTxt(OnvanChap) == "") ? "گزارش خریدها" : OnvanChap;

    if (Chap == "CHAP" || Chap == "PDF")
    {

    // code in your main method
    Document.Create(container =>
    {
    container.Page(page =>
    {
    page.Size(PageSizes.A4);
    page.Margin(1, Unit.Centimetre);
    page.PageColor(Colors.White);
    page.DefaultTextStyle(x => x.FontSize(10));
    page.ContentFromRightToLeft();

    static IContainer DefaultCellStyle(IContainer container, string backgroundColor = "")
    {
    return container
    .Border(1)
    .BorderColor(Colors.Grey.Lighten1)
    .Background(!string.IsNullOrEmpty(backgroundColor) ? backgroundColor : Colors.White)
    .PaddingVertical(7)
    .PaddingHorizontal(3);
    }
    var RJ = 0;

    page.Header()
    .Text(OnvanChap)
    .SemiBold().FontSize(14).FontColor(Colors.Blue.Medium);

    page.Content()
    .PaddingVertical(1, Unit.Centimetre)
    .Border(1)
    .Table(table =>
    {
    table.ColumnsDefinition(columns =>
    {
    columns.RelativeColumn(1);
    columns.RelativeColumn(5);
    columns.RelativeColumn(4);
    columns.RelativeColumn(6);
    columns.RelativeColumn(8);
    columns.RelativeColumn(12);
    });
    table.Header(header =>
    {
    header.Cell().Element(CellStyle).AlignCenter().Text("#").FontSize(11).SemiBold();
    header.Cell().Element(CellStyle).Text("تاریخ").FontSize(11).SemiBold();
    header.Cell().Element(CellStyle).Text("شماره").FontSize(11).SemiBold();
    header.Cell().Element(CellStyle).Text("حجم کالا").FontSize(11).SemiBold();
    header.Cell().Element(CellStyle).Text("مبلغ برگه").FontSize(11).SemiBold();
    header.Cell().Element(CellStyle).Text("توضیح").FontSize(11).SemiBold();


    // you can extend existing styles by creating additional methods
    IContainer CellStyle(IContainer container) => DefaultCellStyle(container, Colors.Grey.Lighten3);
    });

    foreach (DataRow item in ListPrint.Rows)
    {
    RJ++;
    table.Cell().Element(CellStyle).Text(RJ.ToString()).FontSize(11);
    table.Cell().Element(CellStyle).Text(item["DDateKharid"].ToString()).FontSize(11);
    table.Cell().Element(CellStyle).Text(item["Num"].ToString()).FontSize(11);
    table.Cell().Element(CellStyle).Text(item["SumNq"].ToString().ToComma()).FontSize(11);
    table.Cell().Element(CellStyle).Text(item["SumPrice"].ToString().ToComma()).FontSize(11);
    table.Cell().Element(CellStyle).Text(item["Tp"].ToString()).FontSize(11);
    }

    IContainer CellStyle(IContainer container) => DefaultCellStyle(container).ShowOnce();
    });


    page.Footer()
    .AlignCenter()
    .Text(x =>
    {
    x.Span("صفحه");
    x.CurrentPageNumber();
    });
    });
    })
    .GeneratePdf(FileName);

    }
    if (Chap == "XLS")
    {

    string sheetName = " گزارش لیست خریدها";
    // فایلی از نوع xlsx
    IWorkbook workbook = new XSSFWorkbook();
    //ایجاد شیت در فایل اکسل
    ISheet sheet = workbook.CreateSheet(sheetName);
    sheet.IsRightToLeft = true;
    // ایجاد عنصر سطر
    IRow row = sheet.CreateRow(1);

    IFont font = workbook.CreateFont();
    font.IsBold = true;
    font.FontHeightInPoints = 14;
    ICellStyle boldStyle = workbook.CreateCellStyle();
    boldStyle.SetFont(font);

    int _Row = 1;
    sheet.AddMergedRegion(new CellRangeAddress(_Row, _Row + 1, 1, 10));
    row = sheet.CreateRow(_Row);
    Center.CellAddData(row, 1, OnvanChap, CellType.String); ;

    _Row += 3;
    row = sheet.CreateRow(_Row);
    Center.CellAddData(row, 1, "تاریخ", CellType.String);
    Center.CellAddData(row, 2, "شماره", CellType.String);
    Center.CellAddData(row, 3, "مقدار کل", CellType.String);
    Center.CellAddData(row, 4, "مبلغ کل", CellType.String);
    Center.CellAddData(row, 5, "شرح", CellType.String);


    foreach (DataRow item in ListPrint.Rows)
    {
    _Row += 1;
    row = sheet.CreateRow(_Row);
    // پرکردن سلولها
    Center.CellAddData(row, 1, item["DDateKharid"].ToString(), CellType.String);
    Center.CellAddData(row, 2, item["Num"].ToString(), CellType.String);
    Center.CellAddData(row, 3, item["SumNq"].ToString(), CellType.Numeric);
    Center.CellAddData(row, 4, item["SumPrice"].ToString(), CellType.String);
    Center.CellAddData(row, 5, item["Tp"].ToString(), CellType.Numeric);

    // سایزبندی 20 ستون در شیت
    for (int i = 0; i <= 20; i++) sheet.AutoSizeColumn(i, true);

    using (FileStream stream = new FileStream(FileName, FileMode.Create, FileAccess.Write, FileShare.None))
    {
    workbook.Write(stream);
    }

    }

    }
    }
    catch (Exception ex)
    {
    Center.ChapEmpty(_hostingEnvironment.WebRootPath, VU, Request.Cookies["User.Sarmad.ir"], Chap);

    await DBS.LogErrorSaveCmdAsync(ComText, Center.GetUserId(Request.Cookies["User.Sarmad.ir"]), FormId, MethodBase.GetCurrentMethod().Name, ex.Message);
    }
    return Content("OK");
    }


